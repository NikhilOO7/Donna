{
  "annotations": { "list": [] },
  "editable": true,
  "schemaVersion": 39,
  "title": "Meeting Assistant — API & Pipelines",
  "tags": ["meeting-assistant"],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "HTTP request rate (req/s by status)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP p95 latency (s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, path) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{path}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "External API call rate (by service + status)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (service, status) (rate(external_api_calls_total[5m]))",
          "legendFormat": "{{service}} {{status}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "External API p95 latency by service (s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(external_api_duration_seconds_bucket[5m])))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "RAG query p95 latency (s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rag_query_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 6,
      "title": "Document processing p95 (s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, processing_method) (rate(document_processing_duration_seconds_bucket[5m])))",
          "legendFormat": "{{processing_method}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Active voice sessions",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "voice_sessions_active", "legendFormat": "active" }]
    },
    {
      "id": 8,
      "title": "Cache hit ratio",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(cache_hits_total[5m])) / (sum(rate(cache_hits_total[5m])) + sum(rate(cache_misses_total[5m])))",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "id": 9,
      "title": "Per-agent latency (Tempo traces)",
      "type": "text",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "options": {
        "mode": "markdown",
        "content": "Per-agent latency lives in **Tempo traces** (spans `agent.scribe`, `agent.context`, `agent.insight`, `agent.fact_check`, `agent.kg_query`). Open **Explore → Tempo**, search service `Voice Document Intelligence`, and inspect the `dispatch` trace to see each agent's span duration. Requires `ENABLE_TRACING=true`."
      }
    }
  ]
}
