# .env.example - Updated with LiveKit Voice Configuration

# Application
APP_NAME="Voice Document Intelligence"
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# API Settings
API_PORT=8000
CORS_ORIGINS=http://localhost:4321

# Database
DATABASE_URL=postgresql+asyncpg://docintell:docintell123@localhost:5432/document_intelligence
REDIS_URL=redis://localhost:6379

# Vector Databases
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# TigerGraph
TIGERGRAPH_HOST=localhost
TIGERGRAPH_REST_PORT=9000
TIGERGRAPH_GS_PORT=14240
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=tigergraph123

# AI/LLM APIs
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo
EMBEDDING_MODEL=text-embedding-3-large

# Better Embeddings (Optional)
VOYAGE_API_KEY=your_voyage_api_key_here
VOYAGE_MODEL=voyage-3-large

# LiveKit Voice Processing (REQUIRED FOR VOICE)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Voice AI Providers
DEEPGRAM_API_KEY=your_deepgram_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here  # Optional, can use OpenAI TTS
CARTESIA_API_KEY=your_cartesia_api_key_here      # Optional, advanced TTS

# Voice Agent Configuration
VOICE_AGENT_TIMEOUT=300
VOICE_INTERRUPTION_THRESHOLD=0.5
VOICE_ENDPOINTING_DELAY=0.8

# Storage
MINIO_ENDPOINT=localhost:9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents

# Temporal Workflows
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# Pulsar Events
PULSAR_URL=pulsar://localhost:6650
PULSAR_TOPIC_PREFIX=doc-intel

# Document Processing
MAX_FILE_SIZE=104857600  # 100MB
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Security
JWT_SECRET=your-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# --- Integrations (optional) -------------------------------------------------
# Inbound email research (H4): shared secret for the Postmark inbound webhook.
# Point Postmark's inbound stream at:
#   https://<your-api>/api/v1/integrations/email/inbound?token=<this value>
POSTMARK_INBOUND_TOKEN=

# Google Calendar ingestion (H5): OAuth client from console.cloud.google.com
# (Calendar API, scope calendar.readonly). Endpoints 503 until set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback

# Public URL of the web app (used in emails and OAuth redirects)
FRONTEND_URL=http://localhost:3000

# URL browsers use to reach LiveKit (the in-compose LIVEKIT_URL is the
# docker-internal hostname, unreachable from a browser).
LIVEKIT_PUBLIC_URL=ws://localhost:7880
